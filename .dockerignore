# ═══════════════════════════════════════════════════════════════════
# .dockerignore — Loại trừ các file không cần thiết và file nhạy cảm
# ═══════════════════════════════════════════════════════════════════

# File nhạy cảm / môi trường
.env
.env.*
!.env.example

# Git
.git
.gitignore

# Virtual environment & Python cache
.venv
venv
__pycache__
*.py[cod]
*$py.class
*.pytest_cache
.pytest_cache

# Tests, screenshots & tài liệu không cần trong container runtime
tests
screenshots
exercises.md
*.md